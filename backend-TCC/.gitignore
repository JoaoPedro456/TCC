# Arquivos de configuração local com senhas
# (o .gitignore NÃO aceita comentário na mesma linha do padrão)
# application-dev.properties é versionado: ele só referencia variáveis de ambiente.
# Coloque valores reais apenas em arquivos locais abaixo, que nunca são commitados.
application-local.properties
application-*-local.properties
*.env
.env
.env.*

